DEVDNA_ENVIRONMENT=development
DEVDNA_DATABASE_URL=postgresql+asyncpg://devdna:devdna@localhost:5432/devdna
DEVDNA_REDIS_URL=redis://localhost:6379/0
DEVDNA_LOG_LEVEL=INFO

# Required in staging and production. Generate each secret with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVDNA_API_KEYS=local-developer=replace-with-at-least-24-characters

DEVDNA_ANALYSIS_RATE_LIMIT=10
DEVDNA_ANALYSIS_RATE_WINDOW_SECONDS=60
DEVDNA_MAX_REQUEST_BYTES=16384
DEVDNA_ANALYSIS_RETENTION_DAYS=90
DEVDNA_RETENTION_BATCH_SIZE=500

# Optional; unauthenticated GitHub requests have a lower upstream limit.
DEVDNA_GITHUB_TOKEN=
