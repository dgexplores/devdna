# Production deployment environment. NEVER commit real values.
# Generate any missing secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

DEVDNA_ENVIRONMENT=production

# Neon Postgres (serverless)
DEVDNA_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXX.us-east-2.aws.neon.tech/devdna?sslmode=require

# Upstash Redis (serverless)
DEVDNA_REDIS_URL=rediss://default:TOKEN@xxx.upstash.io:6379

DEVDNA_LOG_LEVEL=INFO

# Comma-separated client=secret pairs. Replace with fresh high-entropy values.
DEVDNA_API_KEYS=client1=replace-with-at-least-24-characters
DEVDNA_WEB_SESSION_SECRET=replace-with-an-independent-high-entropy-secret
DEVDNA_WEB_SESSION_HOURS=8

# Optional: unauthenticated GitHub API has a low upstream limit.
# A classic PAT ("repo" scope not needed for public data) raises it.
DEVDNA_GITHUB_TOKEN=

# Clerk authentication (Google/GitHub/email sign-in). Empty = auth buttons hidden.
DEVDNA_CLERK_PUBLISHABLE_KEY=pk_test_...
DEVDNA_CLERK_SECRET_KEY=sk_test_...
DEVDNA_CLERK_JWKS_URL=https://<app>.clerk.accounts.dev/.well-known/jwks.json
DEVDNA_CLERK_ISSUER=https://<app>.clerk.accounts.dev
DEVDNA_CLERK_WEBHOOK_SECRET=whsec_...
DEVDNA_CLERK_DOMAIN=https://www.clerk.com

# Rate limits and limits (defaults shown)
DEVDNA_ANALYSIS_RATE_LIMIT=10
DEVDNA_ANALYSIS_RATE_WINDOW_SECONDS=60
DEVDNA_MAX_REQUEST_BYTES=16384
DEVDNA_ANALYSIS_RETENTION_DAYS=90
DEVDNA_RETENTION_BATCH_SIZE=500
DEVDNA_RECRUITER_UPLOAD_MAX_BYTES=1048576
DEVDNA_RECRUITER_BATCH_MAX_CANDIDATES=50
DEVDNA_RECRUITER_BATCH_RATE_LIMIT=3
DEVDNA_RECRUITER_BATCH_RATE_WINDOW_SECONDS=60
DEVDNA_CV_UPLOAD_MAX_BYTES=2097152
DEVDNA_CV_MAX_PAGES=10
DEVDNA_CV_MAX_CHARACTERS=100000
